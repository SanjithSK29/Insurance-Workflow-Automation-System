# Copy to .env (or set in your deployment) for any environment that keeps data.
PORT=3000
IWAS_DB=./iwas.db
# 64 hex chars = 32-byte AES-256 key for PII encryption at rest
DATA_KEY=
# Secret for signing JWT access tokens
JWT_SECRET=
# Ed25519 private key (PKCS8 PEM) used to sign policy/settlement documents
SIGNING_KEY_PEM=
# Enable HTTPS (TLS 1.2+) by pointing at a certificate and key
TLS_CERT=
TLS_KEY=
RISK_THRESHOLD=60
# Short-rate retention (%) deducted from the pro-rata refund on cancellation
CANCELLATION_FEE_PERCENT=5
RATE_LIMIT_MAX=300
RATE_LIMIT_PUBLIC_MAX=60
# Lock an account for LOCKOUT_MINUTES after LOCKOUT_MAX_ATTEMPTS failed logins
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15
SEED_DEMO=true
