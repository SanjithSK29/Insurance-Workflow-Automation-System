# Copy to .env (or set in your deployment) for any environment that keeps data.
# Generate long random values for DATA_KEY, JWT_SECRET and SIGNING_KEY_PEM;
# otherwise keys are regenerated on each start and stored data becomes unreadable.

# HTTP port the server listens on
PORT=3000

# SQLite database path (node:sqlite, no external database server needed)
IWAS_DB=./iwas.db

# 64 hex chars = 32-byte AES-256 key for PII encryption at rest
DATA_KEY=

# Secret for signing JWT access tokens
JWT_SECRET=

# Ed25519 private key (PKCS8 PEM) used to sign policy/settlement documents
SIGNING_KEY_PEM=

# Enable HTTPS (TLS 1.2+) by pointing at a certificate and key
TLS_CERT=
TLS_KEY=

# Underwriting manual-review threshold (0–100)
RISK_THRESHOLD=60

# Short-rate retention (%) deducted from the pro-rata refund on cancellation
CANCELLATION_FEE_PERCENT=5

RATE_LIMIT_MAX=300
RATE_LIMIT_PUBLIC_MAX=60

# Lock an account for LOCKOUT_MINUTES after LOCKOUT_MAX_ATTEMPTS failed logins
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Seed demo accounts and data on first start
SEED_DEMO=true
